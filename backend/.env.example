# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local Mongo:      mongodb://localhost:27017
# Mongo Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL="mongodb://localhost:27017"
DB_NAME="news_summarizer"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to hit the API. "*" is fine for local.
CORS_ORIGINS="*"

# ─── AI (Claude Sonnet 4.5 via Emergent universal key) ───────────────────────
# Get yours at: https://app.emergent.sh/  →  Profile  →  Universal Key
# The single key works for OpenAI / Anthropic / Gemini through emergentintegrations.
EMERGENT_LLM_KEY="sk-emergent-XXXXXXXXXXXXXXXX"

# ─── Live Search (Tavily) ────────────────────────────────────────────────────
# Get a free API key at: https://tavily.com/  (1000 free searches/month).
TAVILY_API_KEY="tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ─── Rate limits (per IP, sliding hour) ──────────────────────────────────────
RATE_LIMIT_SUMMARY=15
RATE_LIMIT_UPDATES=15
RATE_LIMIT_TRANSLATE=15

# ─── Cache TTL (hours) ───────────────────────────────────────────────────────
CACHE_TTL_HOURS=24
