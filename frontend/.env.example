# Where the React app finds the backend.
# For local dev use http://localhost:8001
# For a deployed backend, paste its full https URL (no trailing slash).
REACT_APP_BACKEND_URL=http://localhost:8001

# Web-socket port for CRA dev server (leave as-is unless you know you need it)
WDS_SOCKET_PORT=3000

# Toggle the internal health-check ping
ENABLE_HEALTH_CHECK=false
